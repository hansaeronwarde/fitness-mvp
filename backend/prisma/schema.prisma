generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  checkIns    CheckIn[]

  @@index([name])
}

model Plan {
  id           String   @id @default(uuid())
  name         String
  price        Float
  durationDays Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
}

enum MembershipStatus {
  active
  cancelled
}

model Membership {
  id        String           @id @default(uuid())
  memberId  String
  planId    String
  startDate DateTime
  endDate   DateTime?
  status    MembershipStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  member Member @relation(fields: [memberId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([memberId, planId, status])
}

model CheckIn {
  id        String   @id @default(uuid())
  memberId  String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, createdAt])
}
